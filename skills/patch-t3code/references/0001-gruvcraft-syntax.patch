diff --git a/apps/web/src/lib/gruvwareSyntaxTheme.ts b/apps/web/src/lib/gruvwareSyntaxTheme.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b65c54725c80a3918ceaf180036c0b6e654a97d2
--- /dev/null
+++ b/apps/web/src/lib/gruvwareSyntaxTheme.ts
@@ -0,0 +1,115 @@
+import { getResolvedOrResolveTheme, registerCustomTheme } from "@pierre/diffs";
+
+import { READABLE_LIGHT_THEME_NAME } from "./readableSyntaxTheme";
+
+export const GRUVWARE_THEME_NAMES = {
+  light: "gruvware-light",
+  dark: "gruvware-dark",
+} as const;
+
+// Resolved from dotfiles/.config/opencode/themes/gruvware.json; keep builds independent of dotfiles.
+const palettes = {
+  light: {
+    comment: "#7c6f64",
+    keyword: "#9d0006",
+    function: "#79740e",
+    variable: "#076678",
+    string: "#b57614",
+    number: "#8f3f71",
+    type: "#427b58",
+    operator: "#af3a03",
+    punctuation: "#3c3836",
+  },
+  dark: {
+    comment: "#695e55",
+    keyword: "#d4be98",
+    function: "#d4be98",
+    variable: "#b2ba8e",
+    string: "#bac584",
+    number: "#d6b37b",
+    type: "#e6d5ae",
+    operator: "#d4be98",
+    punctuation: "#eead83",
+  },
+} as const;
+
+const scopeRoles: Record<string, keyof typeof palettes.light> = {
+  comment: "comment",
+  hint: "comment",
+  predictive: "comment",
+  keyword: "keyword",
+  at_keyword: "keyword",
+  preproc: "keyword",
+  function: "function",
+  method_definition: "function",
+  variable: "variable",
+  property: "variable",
+  property_name: "variable",
+  property_identifier: "variable",
+  shorthand_property_identifier: "variable",
+  shorthand_property_identifier_pattern: "variable",
+  this: "variable",
+  self: "variable",
+  label: "variable",
+  string: "string",
+  template_string: "string",
+  text: "string",
+  number: "number",
+  boolean: "number",
+  constant: "number",
+  value: "number",
+  plain_value: "number",
+  unit: "number",
+  color: "number",
+  variant: "number",
+  type: "type",
+  constructor: "type" as const,
+  class: "type",
+  class_name: "type",
+  enum: "type",
+  namespace: "type",
+  tag: "type",
+  tag_name: "type",
+  attribute: "type",
+  decorator: "type",
+  selector: "type",
+  pseudo_class_selector: "type",
+  pseudo_element_selector: "type",
+  id_name: "variable",
+  operator: "operator",
+  "keyword.operator": "operator",
+  punctuation: "punctuation",
+};
+
+for (const appearance of ["light", "dark"] as const) {
+  const name = GRUVWARE_THEME_NAMES[appearance];
+  registerCustomTheme(
+    name,
+    async () => {
+      const baseName = appearance === "light" ? READABLE_LIGHT_THEME_NAME : "pierre-dark";
+      const base = await getResolvedOrResolveTheme(baseName, "highlights");
+      if (!base.zed) throw new Error(`${baseName} has no Highlights palette`);
+      const palette = palettes[appearance];
+      const foreground = appearance === "light" ? "#3c3836" : "#d4be98";
+      const syntax = Object.fromEntries(
+        Object.entries(base.zed.style.syntax ?? {}).map(([scope, style]) => {
+          if (scope.startsWith("diff.")) return [scope, style];
+          const role = scopeRoles[scope] ?? scopeRoles[scope.split(".")[0]!];
+          return [
+            scope,
+            {
+              ...(typeof style === "string" ? {} : style),
+              color: role ? palette[role] : foreground,
+            },
+          ];
+        }),
+      );
+      return {
+        ...base.zed,
+        name,
+        style: { ...base.zed.style, syntax },
+      };
+    },
+    "zed",
+  );
+}
