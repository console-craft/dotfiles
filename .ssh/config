# Default ssh key-pair settings

# To generate each pairs use: ssh-keygen -C "$(whoami)@$(uname -n)-$(date -I)"
# Save as:
# ~/.ssh/id_ed25519 and ~/.ssh/id_ed25519.pub
# ~/.ssh/id_ed25519_console-craft and ~/.ssh/id_ed25519_work.pub
# Copy to Github:
# wl-copy < ~/.ssh/id_ed25519.pub
# wl-copy < ~/.ssh/id_ed25519_work.pub

Host *
  AddKeysToAgent yes

# This block must be first, before the Default (Host github.com) bellow
# Host github.com-work
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519_work
#   IdentitiesOnly yes

# Default block
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# GitHub repo setup that uses the additional key-pairs instead of the defaults:
#
# git clone git@github.com-work:Hackerware/some-repo.git
# cd some-repo
# git config user.name "Ovi Work"
# git config user.email "ovi@work.com"

# If not using keyring, cache ssh key passphrases in the current terminal session:
#
# eval $(ssh-agent)
# ssh-add ~/.ssh/id_ed25519
# ssh-add ~/.ssh/id_ed25519_work

