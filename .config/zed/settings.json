{
  "git": {
    "commit_view": {
      "expand_description": true,
    },
    "inline_blame": {
      "show_commit_summary": true,
    },
    "auto_fetch": {
      "enabled": true,
    },
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "commit_editor": "collapsed",
    "folder_indicator": "both",
    "file_icons": true,
    "tree_view": true,
    "collapse_untracked_diff": false,
    "group_by": "staging",
    "status_style": "label_color",
  },
  "project_panel": {
    "indent_size": 15.0,
    "folder_indicator": "both",
    "entry_spacing": "standard",
    "git_status_indicator": true,
  },
  "terminal": {
    "scroll_multiplier": 3.0,
    "copy_on_select": true,
    "blinking": "on",
    "font_weight": 100.0,
  },
  "ssh_connections": [
    {
      "host": "thinkpad-t480",
      "username": "ovi",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ovi/Projects"],
        },
        {
          "paths": ["/home/ovi/Projects/console-craft/skill-issues-presentation"],
        },
      ],
    },
  ],
  "agent_servers": {
    "opencode-v2": {
      "favorite_config_option_values": {
        "effort": ["high"],
        "model": ["openai/gpt-6.2-sol-fast"],
      },
      "default_config_options": {
        "effort": "high",
        "model": "openai/gpt-6.2-sol-fast",
      },
      "type": "registry",
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "model": ["gpt-6.2-sol"],
      },
      "default_config_options": {
        "fast-mode": true,
        "reasoning_effort": "high",
        "model": "gpt-6.2-sol",
      },
      "type": "registry",
    },
  },
  "agent": {
    "max_content_width": 850.0,
    "default_model": {
      "speed": "fast",
      "provider": "openai-subscribed",
      "model": "gpt-6.2-sol",
      "enable_thinking": true,
      "effort": "high",
    },
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-6.2-sol",
        "enable_thinking": true,
        "effort": "medium",
      },
    ],
    "model_parameters": [],
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.2-sol",
      "enable_thinking": true,
      "effort": "high",
    },
  },
  "edit_predictions": {
    "provider": "copilot",
    "allow_data_collection": "no",
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.8,
  },
  "focus_follows_mouse": {
    "debounce_ms": 0,
    "enabled": true,
  },
  "bottom_dock_layout": "right_aligned",
  "preview_tabs": {
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_from_project_panel": false,
    "enabled": false,
    "enable_keep_preview_on_code_navigation": false,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "status_bar": {
    "show_active_file": true,
  },
  "scrollbar": {
    "show": "always",
  },
  "use_smartcase_search": true,
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "document_folding_ranges": "on",
  "document_symbols": "on",
  "semantic_tokens": "combined",
  "lsp_results_location": "multi_buffer",
  "inlay_hints": {
    "enabled": true,
  },
  "completion_menu_item_kind": "symbol",
  "completion_menu_scrollbar": "always",
  "format_on_save": "on",
  "indent_guides": {
    "active_line_width": 2,
  },
  "preferred_line_length": 100,
  "soft_wrap_indent": "extra_one",
  "show_wrap_guides": true,
  "soft_wrap": "bounded",
  "vim": {
    "use_smartcase_find": true,
  },
  "toolbar": {
    "code_actions": true,
  },
  "minimap": {
    "max_width_columns": 40,
    "show": "auto",
  },
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "hover_popover_hiding_delay": 0,
  "hover_popover_delay": 250,
  "show_signature_help_after_edits": true,
  "sticky_scroll": {
    "enabled": true,
  },
  "autoscroll_on_clicks": true,
  "scroll_sensitivity": 3.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "diff_view_style": "split",
  "vertical_scroll_margin": 4.0,
  "minimum_split_diff_width": 120.0,
  "outline_panel": {
    "indent_size": 15.0,
    "folder_indicator": "both",
    "expand_outlines_with_depth": 1,
  },
  "excerpt_context_lines": 10,
  "expand_excerpt_lines": 20,
  "which_key": {
    "delay_ms": 250,
    "enabled": true,
  },
  "cursor_animation": {
    "enabled": true,
  },
  "tabs": {
    "show_diagnostics": "all",
    "close_position": "left",
    "git_status": true,
    "file_icons": true,
  },
  "agent_ui_font_size": 13.0,
  "agent_buffer_font_size": 10.0,
  "markdown_preview": {
    "font_size": 12.0,
    "heading_font_weight": 600.0,
    "font_family": "Geist",
  },
  "ui_font_weight": 300.0,
  "ui_font_family": "Geist",
  "buffer_font_weight": 100.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "use_system_prompts": false,
  "use_system_path_prompts": false,
  "when_closing_with_no_tabs": "keep_window_open",
  "vim_mode": true,
  "ui_font_size": 12.0,
  "buffer_font_size": 10.0,
  "theme": {
    "mode": "system",
    "light": "Gruvcraft Light Soft",
    "dark": "Gruvcraft Dark Soft",
  },
}
