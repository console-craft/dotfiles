        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#bdae93"
    },
    "scrollbar": {
      "base": "$hue.neutral.200"
    },
    "diff": {
      "text": {
        "added": "$hue.yellow.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.accent.200"
      },
      "background": {
        "added": "#e2e0b5",
        "removed": "#e9d8d5",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "$hue.yellow.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "#bdae93",
        "background": {
          "added": "#d4d2a9",
          "removed": "#d8cbc8"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.red.200",
      "function": "$hue.yellow.200",
      "variable": "$hue.interactive.200",
      "string": "#b57614",
