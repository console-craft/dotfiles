{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg0": "#2a2928",
    "darkBg1": "#33302e",
    "darkBg2": "#3b3634",
    "darkBg3": "#4c4641",
    "darkFg0": "#e6d5ae",
    "darkFg1": "#d4be98",
    "darkGray": "#695e55",
    "darkRed": "#de9880",
    "darkGreen": "#bac584",
    "darkYellow": "#d6b37b",
    "darkBlue": "#adb79d",
    "darkPurple": "#d4a599",
    "darkAqua": "#b2ba8e",
    "darkOrange": "#eead83",
    "darkRedBright": "#ea6962",
    "darkGreenBright": "#a9b665",
    "darkYellowBright": "#d8a657",
    "darkPurpleBright": "#d3869b",
    "darkAquaBright": "#89b482",
    "darkOrangeBright": "#e78a4e",
    "lightBg0": "#fbf1c7",
    "lightBg1": "#ebdbb2",
    "lightBg2": "#d5c4a1",
    "lightBg3": "#bdae93",
    "lightFg0": "#282828",
    "lightFg1": "#3c3836",
    "lightGray": "#7c6f64",
    "lightRed": "#9d0006",
    "lightGreen": "#79740e",
    "lightYellow": "#b57614",
    "lightBlue": "#076678",
    "lightPurple": "#8f3f71",
    "lightAqua": "#427b58",
    "lightOrange": "#af3a03"
  },
  "theme": {
    "primary": { "dark": "darkBlue", "light": "lightBlue" },
    "secondary": { "dark": "darkOrange", "light": "lightPurple" },
    "accent": { "dark": "darkBlue", "light": "lightAqua" },
    "error": { "dark": "darkRedBright", "light": "lightRed" },
    "warning": { "dark": "darkOrangeBright", "light": "lightOrange" },
    "success": { "dark": "darkGreenBright", "light": "lightGreen" },
    "info": { "dark": "darkYellowBright", "light": "lightYellow" },
    "text": { "dark": "darkFg1", "light": "lightFg1" },
    "textMuted": { "dark": "darkGray", "light": "lightGray" },
    "background": { "dark": "darkBg1", "light": "lightBg0" },
    "backgroundPanel": { "dark": "darkBg2", "light": "lightBg1" },
    "backgroundElement": { "dark": "darkBg3", "light": "lightBg2" },
    "border": { "dark": "darkGray", "light": "lightBg3" },
    "borderActive": { "dark": "darkFg1", "light": "lightFg1" },
    "borderSubtle": { "dark": "darkBg3", "light": "lightBg2" },
    "diffAdded": { "dark": "darkGreen", "light": "lightGreen" },
    "diffRemoved": { "dark": "darkRed", "light": "lightRed" },
    "diffContext": { "dark": "darkGray", "light": "lightGray" },
    "diffHunkHeader": { "dark": "darkAqua", "light": "lightAqua" },
    "diffHighlightAdded": { "dark": "darkGreenBright", "light": "lightGreen" },
    "diffHighlightRemoved": { "dark": "darkRedBright", "light": "lightRed" },
    "diffAddedBg": { "dark": "#717d3b", "light": "#e2e0b5" },
    "diffRemovedBg": { "dark": "#414526", "light": "#e9d8d5" },
    "diffContextBg": { "dark": "darkBg2", "light": "lightBg1" },
    "diffLineNumber": { "dark": "darkGray", "light": "lightBg3" },
    "diffAddedLineNumberBg": { "dark": "darkBg3", "light": "#d4d2a9" },
    "diffRemovedLineNumberBg": { "dark": "darkBg3", "light": "#d8cbc8" },
    "markdownText": { "dark": "darkFg1", "light": "lightFg1" },
    "markdownHeading": { "dark": "darkYellow", "light": "lightBlue" },
    "markdownLink": { "dark": "darkAqua", "light": "lightAqua" },
    "markdownLinkText": { "dark": "darkGreen", "light": "lightGreen" },
    "markdownCode": { "dark": "darkGreen", "light": "lightYellow" },
    "markdownBlockQuote": { "dark": "darkGray", "light": "lightGray" },
    "markdownEmph": { "dark": "darkFg0", "light": "lightPurple" },
    "markdownStrong": { "dark": "darkFg0", "light": "lightOrange" },
    "markdownHorizontalRule": { "dark": "darkGray", "light": "lightGray" },
    "markdownListItem": { "dark": "darkOrange", "light": "lightBlue" },
    "markdownListEnumeration": {
      "dark": "darkOrange",
      "light": "lightAqua"
    },
    "markdownImage": { "dark": "darkAqua", "light": "lightAqua" },
    "markdownImageText": { "dark": "darkGreen", "light": "lightGreen" },
    "markdownCodeBlock": { "dark": "darkFg1", "light": "lightFg1" },
    "syntaxComment": { "dark": "darkGray", "light": "lightGray" },
    "syntaxKeyword": { "dark": "darkFg1", "light": "lightRed" },
    "syntaxFunction": { "dark": "darkFg1", "light": "lightGreen" },
    "syntaxVariable": { "dark": "darkAqua", "light": "lightBlue" },
    "syntaxString": { "dark": "darkGreen", "light": "lightYellow" },
    "syntaxNumber": { "dark": "darkYellow", "light": "lightPurple" },
    "syntaxType": { "dark": "darkFg0", "light": "lightAqua" },
    "syntaxOperator": { "dark": "darkFg1", "light": "lightOrange" },
    "syntaxPunctuation": { "dark": "darkOrange", "light": "lightFg1" }
  }
}
