{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "instructions": [
    "~/.config/opencode/instructions/workflow-composition.md"
  ],
  "mcp": {
    "sonarqube": {
      "type": "local",
      "enabled": true,
      "timeout": 60000,
      "command": [
        "sonarqube-mcp"
      ]
    }
  }
}
