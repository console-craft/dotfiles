[user]
  name = Ovi Ispas
  email = ovidiu.ispas@gmail.com
[includeIf "gitdir:~/Projects/console-craft/"]
  path = ~/.gitconfig-console-craft
[init]
  defaultBranch = main
[pull]
  rebase = true
[rerere]
  enabled = true
[diff]
  algorithm = patience
  colorMoved = zebra
  context = 1000
[core]
    pager = hunk pager

; ; delta pager options (delta --help)
; ; adjust context size: git diff -U3000
; [core]
;   pager = delta
;
; [interactive]
;   diffFilter = delta --color-only --features=interactive
;
; [delta]
