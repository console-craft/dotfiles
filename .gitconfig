;   line-numbers-left-style = "#333333"
;   line-numbers-right-style = "#333333"
;   line-numbers-minus-style = "#555b33"
;   line-numbers-plus-style = "#8f9a53"
;   line-numbers-zero-style = "#7c6f64"
;   minus-style = "syntax #404426"
;   minus-emph-style = "syntax #555b33"
;   plus-style = "syntax #404426"
;   plus-emph-style = "syntax #555b33"
;   whitespace-error-style = "#8f9a53 reverse"
;   paging = "always"
;
; [delta "interactive"]
